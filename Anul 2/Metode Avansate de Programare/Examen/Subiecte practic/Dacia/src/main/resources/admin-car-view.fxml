<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.AdminCarController">
   <children>
      <Label fx:id="lblDetails" layoutX="32.0" layoutY="14.0" prefHeight="152.0" prefWidth="536.0" text="Label">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <TextField fx:id="txtReason" layoutX="108.0" layoutY="188.0" />
      <Label layoutX="38.0" layoutY="192.0" text="Reason:" />
      <Button fx:id="btnAccept" layoutX="108.0" layoutY="291.0" mnemonicParsing="false" onAction="#onAccept" text="Accept" />
      <Button fx:id="btnDeny" layoutX="205.0" layoutY="291.0" mnemonicParsing="false" onAction="#onDeny" text="Deny" />
   </children>
</AnchorPane>
