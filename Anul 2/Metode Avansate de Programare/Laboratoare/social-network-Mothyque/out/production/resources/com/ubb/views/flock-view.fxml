<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ubb.controller.FlockController"
            prefHeight="600.0" prefWidth="900.0">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Flock Management" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableView">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colName" text="Name" prefWidth="150"/>
                <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                <TableColumn fx:id="colMembers" text="Members (IDs)" prefWidth="300"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="15">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-border-color: #dddddd; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;">
                <Label text="New Flock:" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>

                <TextField fx:id="txtId" promptText="ID" prefWidth="60"/>
                <TextField fx:id="txtName" promptText="Flock Name" prefWidth="150"/>
                <ComboBox fx:id="comboType" promptText="Type" prefWidth="120"/>

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="addButton" text="Create Flock" onAction="#onAdd"
                        style="-fx-base: #4CAF50; -fx-text-fill: white;"/>

                <Button fx:id="deleteButton" text="Delete Flock" onAction="#onDelete"
                        style="-fx-base: #f44336; -fx-text-fill: white;"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Manage Members (Select a flock above):" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>

                <TextField fx:id="txtDuckId" promptText="Duck ID" prefWidth="80"/>

                <Button text="Add Member" onAction="#onAddMember" style="-fx-base: #2196F3; -fx-text-fill: white;"/>
                <Button text="Remove Member" onAction="#onRemoveMember" style="-fx-base: #FF9800; -fx-text-fill: white;"/>
            </HBox>

            <Separator/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="⬅ Back" onAction="#onBack" style="-fx-font-weight: bold;"/>
                <Separator orientation="VERTICAL" />

                <Button fx:id="previousButton" text="Previous" onAction="#onPreviousPage"/>
                <Label fx:id="pageLabel" text="Page 0 of 0"/>
                <Button fx:id="nextButton" text="Next" onAction="#onNextPage"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Items per page:"/>
                <ComboBox fx:id="pageSizeComboBox" prefWidth="70"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>