<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ubb.controller.PersonController"
            prefHeight="600.0" prefWidth="900.0">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Person Management" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableView">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="usernameColumn" text="Username" prefWidth="100"/>
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="150"/>
                <TableColumn fx:id="firstNameColumn" text="First Name" prefWidth="100"/>
                <TableColumn fx:id="lastNameColumn" text="Last Name" prefWidth="100"/>
                <TableColumn fx:id="birthDateColumn" text="Birth Date" prefWidth="100"/>
                <TableColumn fx:id="occupationColumn" text="Occupation" prefWidth="100"/>
                <TableColumn fx:id="empathyColumn" text="Emp." prefWidth="60"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtId" promptText="ID" prefWidth="60"/>
                <TextField fx:id="txtUsername" promptText="Username" prefWidth="120"/>
                <TextField fx:id="txtEmail" promptText="Email" prefWidth="150"/>
                <PasswordField fx:id="txtPassword" promptText="Password" prefWidth="100"/>            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtFirstName" promptText="First Name" prefWidth="120"/>
                <TextField fx:id="txtLastName" promptText="Last Name" prefWidth="120"/>
                <DatePicker fx:id="datePickerBirth" promptText="dd.MM.yyyy" />                <TextField fx:id="txtOccupation" promptText="Occupation" prefWidth="120"/>
                <TextField fx:id="txtEmpathyLevel" promptText="Emp. (1-10)" prefWidth="100"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="addButton" text="Add" onAction="#onAdd"
                        style="-fx-base: #4CAF50; -fx-text-fill: white;"/>

                <Button fx:id="deleteButton" text="Delete" onAction="#onDelete"
                        style="-fx-base: #f44336; -fx-text-fill: white;"/>
            </HBox>

            <Separator/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="⬅ Back" onAction="#onBack" style="-fx-font-weight: bold;"/>
                <Separator orientation="VERTICAL" />

                <Button fx:id="previousButton" text="Previous" onAction="#onPreviousPage"/>
                <Label fx:id="pageLabel" text="Page 0 of 0"/>
                <Button fx:id="nextButton" text="Next" onAction="#onNextPage"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Items per page:"/>
                <ComboBox fx:id="pageSizeComboBox" prefWidth="70"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>