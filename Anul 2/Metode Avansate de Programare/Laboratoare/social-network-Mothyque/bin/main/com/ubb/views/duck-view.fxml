<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ubb.controller.DuckController"
            prefHeight="500.0" prefWidth="700.0">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Filter by Type:"/>

            <ComboBox fx:id="filterComboBox" prefWidth="150.0" onAction="#onFilterChanged"/>

        </HBox>
    </top>

    <center>
        <TableView fx:id="tableView"> <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="nameColumn" text="Username" prefWidth="150"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="150"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="100"/>
            <TableColumn fx:id="speedColumn" text="Speed"/>
            <TableColumn fx:id="enduranceColumn" text="Endurance"/>
        </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtId" promptText="ID" prefWidth="50"/>

                <TextField fx:id="txtUsername" promptText="Username" prefWidth="100"/>
                <TextField fx:id="txtEmail" promptText="Email" prefWidth="120"/>
                <PasswordField fx:id="txtPassword" promptText="Password" prefWidth="100"/>
                <ComboBox fx:id="comboType" promptText="Type" prefWidth="100"/>

                <TextField fx:id="txtSpeed" promptText="Speed" prefWidth="60"/>
                <TextField fx:id="txtEndurance" promptText="Endur." prefWidth="60"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="addButton" text="Add" onAction="#onAdd" style="-fx-base: #4CAF50;"/>
                <Button fx:id="deleteButton" text="Delete" onAction="#onDelete" style="-fx-base: #f44336;"/>
            </HBox>

            <Separator/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="⬅ Back" onAction="#onBack" style="-fx-font-weight: bold;"/>
                <Separator orientation="VERTICAL" />

                <Button fx:id="previousButton" text="Previous" onAction="#onPreviousPage"/>
                <Label fx:id="pageLabel" text="Page 0 of 0"/>
                <Button fx:id="nextButton" text="Next" onAction="#onNextPage"/>

                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Items per page:"/>
                <ComboBox fx:id="pageSizeComboBox" prefWidth="70"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>