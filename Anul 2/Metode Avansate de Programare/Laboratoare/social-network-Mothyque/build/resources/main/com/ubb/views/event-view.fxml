<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ubb.controller.EventController"
            prefHeight="500.0" prefWidth="800.0">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Events History" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableView">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colType" text="Type" prefWidth="80"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
                <TableColumn fx:id="colParticipants" text="Participants (IDs)" prefWidth="250"/>
                <TableColumn fx:id="colWinner" text="Winner (ID)" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Participants (IDs):"/>
                <TextField fx:id="txtParticipants" promptText="Ex: 1 5 8" prefWidth="300"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="addButton" text="Create Race" onAction="#onAdd" style="-fx-base: #4CAF50;"/>
                <Button fx:id="deleteButton" text="Delete" onAction="#onDelete" style="-fx-base: #f44336;"/>
                <Button text="▶ Run Race" onAction="#onRunRace" style="-fx-base: #2196F3;"/>
            </HBox>

            <Separator/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="⬅ Back" onAction="#onBack" style="-fx-font-weight: bold;"/>
                <Separator orientation="VERTICAL" />

                <Button fx:id="previousButton" text="Previous" onAction="#onPreviousPage"/>
                <Label fx:id="pageLabel" text="Page 0 of 0"/>
                <Button fx:id="nextButton" text="Next" onAction="#onNextPage"/>

                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Items per page:"/>
                <ComboBox fx:id="pageSizeComboBox" prefWidth="70"/>

            </HBox>
        </VBox>
    </bottom>

</BorderPane>