<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ubb.controller.CommunityController"
            prefHeight="550.0" prefWidth="900.0">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <center>
        <HBox spacing="30.0" alignment="CENTER">

            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <Label text="Lista Prietenii" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

                <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId1" text="User ID 1" prefWidth="120"/>
                        <TableColumn fx:id="colId2" text="User ID 2" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <Separator orientation="VERTICAL" />

            <VBox alignment="CENTER" spacing="20.0" minWidth="320.0">

                <Label text="Statistici Comunitate"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #555;"/>

                <VBox alignment="CENTER" spacing="20.0"
                      style="-fx-background-color: #f4f4f4; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #ccc; -fx-border-radius: 10;">

                    <Label fx:id="lblNumberOfCommunities"
                           text="Calculating..."
                           style="-fx-font-size: 18px; -fx-text-fill: #2a2a2a;"/>

                    <Label fx:id="lblMostSociableCommunity"
                           text="Calculating..."
                           style="-fx-font-size: 18px; -fx-text-fill: #2a2a2a;"/>
                </VBox>

                <Separator prefWidth="200.0" />

                <VBox alignment="CENTER" spacing="10.0" maxWidth="300.0">
                    <Label text="Manage Friendships" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>

                    <TextField fx:id="txtId1" promptText="User ID 1" alignment="CENTER"/>
                    <TextField fx:id="txtId2" promptText="User ID 2" alignment="CENTER"/>

                    <HBox spacing="20.0" alignment="CENTER">
                        <Button text="Add" onAction="#onAddFriendship"
                                style="-fx-base: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>

                        <Button text="Remove" onAction="#onRemoveFriendship"
                                style="-fx-base: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <padding>
                <Insets top="20.0"/>
            </padding>

            <Button text="⬅ Back" onAction="#onBack" style="-fx-font-weight: bold;"/>

            <Separator orientation="VERTICAL" />

            <Button fx:id="previousButton" text="Previous" onAction="#onPreviousPage"/>
            <Label fx:id="pageLabel" text="Page 0 of 0"/>
            <Button fx:id="nextButton" text="Next" onAction="#onNextPage"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Items per page:"/>
            <ComboBox fx:id="pageSizeComboBox" prefWidth="70"/>
        </HBox>
    </bottom>

</BorderPane>