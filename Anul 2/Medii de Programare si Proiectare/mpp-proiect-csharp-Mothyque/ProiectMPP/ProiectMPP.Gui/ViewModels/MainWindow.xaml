<local:MessageController x:Class="ProiectMPP.Client.ViewModels.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProiectMPP.Client.ViewModels"
        Title="Basketball Match Manager" Height="700" Width="1300">

    <Canvas Background="#F4F4F4">
        <Label Content="Available Matches:" Canvas.Left="14" Canvas.Top="410" FontWeight="Bold"/>
        <DataGrid x:Name="dgMatches" Canvas.Left="14" Canvas.Top="435" 
                  Width="950" Height="210" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Match Information" Binding="{Binding}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AvailableSeats}" Value="0">
                                    <Setter Property="Foreground" Value="Red" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Label Content="Search Results / Client Tickets:" Canvas.Left="14" Canvas.Top="70" FontWeight="Bold"/>
        <DataGrid x:Name="dgTickets" Canvas.Left="14" Canvas.Top="96" 
                  Width="950" Height="210" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ticket Details" Binding="{Binding}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Header="Operations" Canvas.Left="1000" Canvas.Top="96" Width="260" Height="300">
            <StackPanel Margin="10">
                <Label Content="Client Name:"/>
                <TextBox x:Name="txtName" Margin="0,0,0,10"/>

                <Label Content="Address:"/>
                <TextBox x:Name="txtAddress" Margin="0,0,0,10"/>

                <Button Content="Search" Click="onSearch_Click" Margin="0,0,0,20"/>

                <Label Content="Number of Tickets:"/>
                <TextBox x:Name="txtTicket" Text="1" Margin="0,0,0,10"/>

                <UniformGrid Columns="2">
                    <Button Content="Buy" Click="onBuy_Click" Margin="2" Background="LightGreen"/>
                    <Button Content="Update" Click="onUpdate_Click" Margin="2"/>
                </UniformGrid>
            </StackPanel>
        </GroupBox>

        <Button Content="Logout" Canvas.Left="1000" Canvas.Top="580" 
                Width="260" Height="65" Click="onLogout_Click" Background="#FFE2E2E2"/>
    </Canvas>
</local:MessageController>